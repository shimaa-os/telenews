OPENAI_API_KEY=sk-your-openai-api-key
TELEGRAM_BOT_TOKEN=123456789:telegram-bot-token
TELEGRAM_CHAT_ID=123456789
API_BEARER_TOKEN=change-me-for-manual-endpoints
TIMEZONE=Africa/Cairo
NEWS_LOOKBACK_HOURS=24
MAX_NEWS_ITEMS=10
OPENAI_MODEL=gpt-5-mini
# Optional: for OpenRouter (sk-or-v1-...) set:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=
# X.com sources (no official free RSS - goes via RSSHub, may fail gracefully):
# List X handles comma-separated, e.g. X_HANDLES=Reuters,BreakingNews,elonmusk
# Leave empty to skip X. Custom feeds: EXTRA_RSS_FEEDS=Name|https://...;Name2|https://...
X_HANDLES=
RSSHUB_BASE_URL=https://rsshub.app
EXTRA_RSS_FEEDS=
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
